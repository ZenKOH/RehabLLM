.DS_Store

# Model/data artefacts should not live in normal Git history.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/curated/*
!data/curated/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
*.pt
*.pth
*.bin
*.model
*.vocab
wandb/
runs/

eval/*
!eval/.gitkeep
